# Copy to .env at the repo root. apps/api and apps/web both read it.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8787
SURREAL_URL=surrealkv://./data/clinix
# Models per tier (defaults: claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5) and which tier mines reviews
MODEL_STRONG=
MODEL_FAST=
MODEL_LIGHT=
MINING_TIER=strong
PORT=8787
# Logging: level trace|debug|info|warn|error, format json (servers) or pretty (local)
LOG_LEVEL=info
LOG_FORMAT=pretty
# Until sign-in exists: the user id the web app acts as (match the x-user-id you used)
DEV_USER_ID=sepehr

# Private discipline guides (never in this repo): a local folder, or a private GitHub repo + read-only token
DISCIPLINE_PACKS_DIR=
DISCIPLINE_PACKS_REPO=
GITHUB_TOKEN=

# Optional: Google PageSpeed Insights, for the speed scores in the site-health section.
PAGESPEED_API_KEY=
